<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions for UPI123 payment system -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Lets the in-call overlay's "End call" button actually hang up via TelecomManager.endCall() -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Allows routing UPI123 calls through ProximityConnectionService via TelecomManager.placeCall()
         so the system dialer never appears during a payment. Normal permission — no runtime prompt. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- CAMERA: phone camera for QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- SMS detection via BroadcastReceiver. READ_SMS is deliberately NOT
         requested: the app never reads the SMS inbox, it only receives
         incoming messages while a payment operation is active. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Payment outcomes are also posted as notifications: the direct
         result-screen launch from a background receiver rides the
         overlay-permission exemption and can be silently blocked, and a
         money outcome must never be unreachable. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
         ACCESS_NETWORK_STATE: lets WalledGardenDetector query active networks.
         CHANGE_NETWORK_STATE: required for ConnectivityManager.bindProcessToNetwork()
         which routes the WebView through the operator's captive-portal channel.
         Both are normal permissions — no runtime prompt required.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Camera features for QR code scanning -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Chrome OS compatibility: declare hardware features as optional -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:name=".ProximityApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proximity"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="LockedOrientationActivity"
        tools:targetApi="31">

        <!-- Splash Activity (Launcher Entry Point) -->
        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Proximity.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity" />
        <activity
            android:name=".TestConfigurationActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity" />

        <!-- QR Scanner Activity -->
        <activity
            android:name=".features.qr_scanner.presentation.QRScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />

        <!-- User Attestation Activity -->
        <activity
            android:name=".ui.activities.UserAttestationActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait"
            android:launchMode="singleTask" />

        <!-- Payment Success Activity -->
        <activity
            android:name=".ui.activities.PaymentResultActivity"
            android:exported="false"
            android:theme="@style/PaymentSuccessTheme"
            android:screenOrientation="portrait"
            android:launchMode="singleTask" />

        <!-- FAQ Activity -->
        <activity
            android:name=".ui.activities.FaqActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />

        <!-- Pay Contact Activity -->
        <activity
            android:name=".ui.activities.PayContactActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />

        <!-- Transaction History Activity -->
        <activity
            android:name=".ui.activities.TransactionHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- ConnectionService that intercepts UPI123 outgoing calls so the system
             dialer never appears. Required for TelecomManager.placeCall(). -->
        <service
            android:name=".telecom.ProximityConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Full-screen in-app payment progress screen (replaces the WindowManager overlay) -->
        <activity
            android:name=".ui.activities.PaymentProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait"
            android:launchMode="singleTask" />

        <!-- Accessibility service: reads USSD dialog text during QR payments \n             (user must enable it in Settings > Accessibility) -->
        <service
            android:name=".accessibility.PaymentAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".ui.activities.PaymentGuidanceActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />



        <receiver
            android:name=".receivers.SimpleSMSReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.activities.RechargeWebActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activities.TermsActivity"
            android:exported="false"
            android:theme="@style/Theme.Proximity"
            android:screenOrientation="portrait" />

    </application>

</manifest>
