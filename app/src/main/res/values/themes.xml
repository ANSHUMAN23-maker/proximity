<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Proximity" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/abyssal_charcoal</item>
        <item name="android:colorBackground">@color/abyssal_charcoal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.Proximity" parent="Base.Theme.Proximity" />
    <style name="AppTheme" parent="Base.Theme.Proximity" />

    <style name="Theme.Proximity.Splash" parent="Base.Theme.Proximity">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/abyssal_charcoal</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>

    <style name="AppTheme.Splash" parent="Theme.Proximity.Splash" />

    <style name="PaymentSuccessTheme" parent="Base.Theme.Proximity" />
</resources>
