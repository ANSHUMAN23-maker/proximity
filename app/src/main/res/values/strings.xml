    <string name="setup_ground_rules_title">A few ground rules</string>
    <string name="setup_ground_rules_subtitle">Keep these in mind for a safer experience with Proximity.</string>
    <string name="setup_rule_1_title">Just two details for setup</string>
    <string name="setup_rule_1_body">We only ask for your Bank Name and SIM Operator. We do not ask your Bank IFSC code, any OTP, or UPI access.</string>
    <string name="setup_rule_2_title">Keep sensitive details private</string>
    <string name="setup_rule_2_body">Any kind of banking password or UPI pin is being entered on official government portals. Proximity never read or stores such information. The optional USSD Accessibility Service only reads confirmation text during active QR sessions and turns itself off immediately afterward&#8212;never capturing PINs.</string>
    <string name="setup_rule_3_title">Check before you pay</string>
    <string name="setup_rule_3_body">Confirm the recipient\'s name and mobile number or QR details before sending a payment.</string>
    <string name="setup_permissions_title">App Permissions</string>
    <string name="setup_permissions_subtitle">Proximity needs these permissions to automatically and securely make USSD payments for you.</string>
    <string name="setup_core_permissions_card_title">Core App Permissions</string>
    <string name="setup_core_permissions_card_body">Phone calls, call state, audio control, camera for QR scanning, contacts picker, vibration, incoming bank SMS confirmation, and payment notifications.</string>
