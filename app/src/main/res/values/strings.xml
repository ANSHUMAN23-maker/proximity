    <string name="accessibility_service_label">Proximity USSD Reader</string>
    <string name="accessibility_service_description">Session-scoped USSD confirmation reader for Proximity QR payments. Automatically disables itself when the payment finishes.</string>
    <string name="accessibility_modal_title">Enable Accessibility Service</string>
    <string name="accessibility_modal_body">Proximity uses an optional, session-scoped Accessibility Service solely to read system USSD confirmation dialogs for outcome, amount, recipient, and reference ID during active QR payments, then automatically disables itself. If skipped, Proximity falls back to bank SMS verification.</string>
